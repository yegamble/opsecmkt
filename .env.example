# Use scripts/install.sh to generate random secrets and choose deployment mode.
DATABASE_URL=postgres://opsecmkt:REPLACE_ME@db:5432/opsecmkt?sslmode=disable
POSTGRES_PASSWORD=REPLACE_ME
SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_MODE=clearnet
COOKIE_SECURE=true
APP_PORT=8080
COMPOSE_FILE=compose.yaml:compose.clearnet.yaml:compose.nodes.yaml:compose.internal-db.yaml
COMPOSE_PROFILES=internal-db
# Payments are TESTNET-only; the app refuses mainnet. BITCOIN_RPC_URL is a wallet-enabled Bitcoin Core RPC
# (userinfo = RPC credentials). Blank URLs keep that currency disabled. An unreachable node or missing wallet
# does not stop the site: the currency shows as unavailable and is retried. See docs/testnet-runbook.md.
BITCOIN_RPC_URL=
BITCOIN_WALLET=opsecmkt
# Blank accepts whichever test chain the node reports; set testnet4, signet or regtest to insist on one.
# The local bitcoin service runs testnet4 when this is blank.
BITCOIN_CHAIN=
PAYMENT_CONFIRMATIONS_BTC=3
# MONERO_RPC_URL is the daemon (network and sync check only); MONERO_WALLET_RPC_URL is monero-wallet-rpc,
# with the rpc-login credentials as userinfo (http://marketplace:PASSWORD@monero-wallet:18083).
MONERO_RPC_URL=
MONERO_WALLET_RPC_URL=
# Blank accepts stagenet or testnet as the wallet reports; the local services run stagenet when blank.
MONERO_NETWORK=
PAYMENT_CONFIRMATIONS_XMR=10
PAYMENT_POLL_INTERVAL=30s
# Payment window (Go duration, 10m to 720h): unpaid orders with no deposit seen are cancelled and their stock returned.
PAYMENT_EXPIRY=24h
# 64 hex characters (Ed25519 seed) for signed audit exports; blank = signed export unavailable.
AUDIT_SIGNING_KEY=
# Only needed for optional local nodes; supply reviewed, digest-pinned images.
BITCOIN_IMAGE=
MONERO_IMAGE=
BITCOIN_RPC_PASSWORD=
# rpc-login password for the local monero-wallet service (the service refuses to start without it).
MONERO_WALLET_RPC_PASSWORD=

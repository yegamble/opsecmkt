# Use scripts/install.sh to generate random secrets and choose deployment mode.
DATABASE_URL=postgres://opsecmkt:REPLACE_ME@db:5432/opsecmkt?sslmode=disable
POSTGRES_PASSWORD=REPLACE_ME
SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_MODE=clearnet
COOKIE_SECURE=true
APP_PORT=8080
COMPOSE_FILE=compose.yaml:compose.clearnet.yaml:compose.nodes.yaml:compose.internal-db.yaml
COMPOSE_PROFILES=internal-db
BITCOIN_RPC_URL=
MONERO_RPC_URL=
# Only needed for optional local nodes; supply reviewed, digest-pinned images.
BITCOIN_IMAGE=
MONERO_IMAGE=
BITCOIN_RPC_PASSWORD=

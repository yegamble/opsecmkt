# Use scripts/install.sh to generate random secrets and choose deployment mode.
DATABASE_URL=postgres://opsecmkt:REPLACE_ME@db:5432/opsecmkt?sslmode=disable
POSTGRES_PASSWORD=REPLACE_ME
# Deliberately blank; use `openssl rand -hex 32` output for each (scripts/install.sh writes them). The app
# refuses placeholders and low-variety values.
# APP_SECRET_KEY derives the CSRF/CAPTCHA key and the key sealing TOTP secrets: changing it refuses every form
# open at the time and makes enrolled TOTP secrets unreadable, so set it once and keep it (back it up with .env).
# An install that predates it keeps working with SETUP_TOKEN alone; see UPGRADING.md.
APP_SECRET_KEY=
# SETUP_TOKEN authorizes the first-run /setup page only. Required until setup is complete, ignored afterwards.
SETUP_TOKEN=
# First-start defaults only: stored in PostgreSQL and later changed under Admin > Site access and registration.
# public = visitors can browse; members = sign-in required for site content. Registrations are independent.
# Changing these values after they have been saved does not override an administrator's choices.
INITIAL_SITE_ACCESS=public
INITIAL_REGISTRATIONS=open
# Optional fixed upload-gateway origin for logo uploads from a separate private administrator onion.
# Leave blank for same-origin uploads; private-admin isolated uploads stay unavailable until configured.
BRANDING_UPLOAD_ORIGIN=
# Written by the installer (clearnet or tor). The app validates it against COMPOSE_FILE and applies Tor-specific
# Monero relay guards. COMPOSE_FILE decides exposure; COOKIE_SECURE decides cookie security.
APP_MODE=clearnet
# Retention is opt-in for upgrades. Announce the policy and register holds before enabling.
# Compose mounts persistent external state separately from PostgreSQL.
RETENTION_ENABLED=off
COOKIE_SECURE=true
# Optional private administrator onion: append compose.admin-tor.yaml to the existing Tor COMPOSE_FILE and
# set TOR_ADMIN_AUTH_DIR to an absolute host directory containing public descriptor:x25519:KEY .auth files.
# The overlay sets ADMIN_SOCKET=/run/market-admin/http.sock; do not publish an administrator TCP port.
# Empty/malformed authorization directories refuse Tor startup. See docs/install/tor.md for key generation,
# permissions, activation and revocation. Default installations keep their current single listener.
ADMIN_SOCKET=
TOR_ADMIN_AUTH_DIR=
# Host loopback port for the clearnet app (127.0.0.1:APP_PORT); point the HTTPS reverse proxy at it.
APP_PORT=8080
# Optional startup bounds (Go durations; blank = default): reaching PostgreSQL (1s to 10m, default 15s), waiting
# for another instance's migration lock and applying migrations (1s to 24h, default 10m each). Raise
# MIGRATION_TIMEOUT before an upgrade whose migrations rewrite large tables. See docs/operator-guide.md#migrations.
DATABASE_CONNECT_TIMEOUT=
MIGRATION_LOCK_TIMEOUT=
MIGRATION_TIMEOUT=
# Compose project: containers, volumes and networks are named after it (blank or absent = opsecmkt). Give a second
# checkout on the same host its own name (for example opsecmkt-rehearsal) or it replaces this one's containers and
# its `docker compose down --volumes` deletes this one's data. Never change it on an existing install: it would
# start on new, empty volumes.
COMPOSE_PROJECT_NAME=opsecmkt
COMPOSE_FILE=compose.yaml:compose.clearnet.yaml:compose.nodes.yaml:compose.internal-db.yaml
# Tor only: append mirror (for example internal-db,mirror) to run the onion mirror; ./scripts/install.sh add-mirror
# does it. Keep it here rather than passing --profile to docker compose, which replaces this list. See
# docs/operator-guide.md#optional-onion-mirror.
COMPOSE_PROFILES=internal-db
# Retired pooled-wallet settings must stay blank; the previous release must resolve existing obligations.
MONERO_RPC_URL=
MONERO_WALLET_RPC_URL=
# Monero escrow network: blank or stagenet (test coins), or mainnet (real funds).
# scripts/install.sh defaults new local nodes to mainnet; choose --monero-network stagenet for testing.
# Mainnet needs a blank MONERO_NETWORK_FLAG=; absent MONERO_NETWORK_FLAG runs stagenet.
MONERO_NETWORK=
PAYMENT_CONFIRMATIONS_XMR=10
PAYMENT_POLL_INTERVAL=30s
# Payment window (Go duration, 10m to 720h): unpaid orders with no deposit seen are cancelled and their stock returned;
# underpaid orders with no new deposit for this long are cancelled and what arrived is refunded to the buyer.
PAYMENT_EXPIRY=24h
# Go duration, 20m to 24h: a Monero daemon whose top block is older than this, or that has no connections, counts as
# not synced, and the Monero escrow watcher skips its pass until it is (docs/operator-guide.md#payments).
MONERO_MAX_TIP_AGE=1h
# 64 hex characters (Ed25519 seed) for signed audit exports; blank = signed export unavailable.
AUDIT_SIGNING_KEY=
# Optional public OpenPGP recipient key file inside the app container for encrypted signed audit exports.
# Mount only its public key read-only with a local Compose override; keep the private decryption key offline.
AUDIT_EXPORT_RECIPIENT=
# Optional LOG_DRIVER (absent = json-file): the Docker logging driver of every container, json-file or local,
# rotated at 10 MB x 3 files. Other drivers need docs/operator-guide.md#resource-limits-and-log-rotation.
# Optional TOR_VERSION overrides the signed repository package selected by deploy/Dockerfile.tor; see
# docs/operator-guide.md#tor-image. The installer reads these overrides from .env, not exported shell values.
# Optional local node image overrides. Defaults are pinned, supported releases; do not use :latest. Before
# changing a tag, follow docs/operator-guide.md#node-image-versions. Each default carries its tag's immutable
# multi-arch @sha256 index digest (from `docker buildx imagetools inspect <tag>`), as scripts/install.sh writes it.
MONERO_IMAGE=ghcr.io/sethforprivacy/simple-monerod:v0.18.5.1@sha256:0329465ffc599048efd57712d91d3b4b7d66380bd7205d5d0992cd9faf668e38
MONERO_WALLET_IMAGE=ghcr.io/sethforprivacy/simple-monero-wallet-rpc:v0.18.5.1@sha256:09ff81f470d6d37811e3fde808c5cd1158a8cd2c42abbfb935b33f26f91e879d
# Monero nodes are pruned by default. Set MONERO_PRUNE_FLAGS='' for a full node.
# Returning from pruned to full downloads the chain again. Keep comments on separate lines.
# Keep comments on their own lines: Compose reads an unquoted blank value followed by a comment
# (MONERO_PRUNE_FLAGS= # full node) as the value "# full node", which monerod receives as the arguments
# "#", "full" and "node".
MONERO_PRUNE_FLAGS='--prune-blockchain --sync-pruned-blocks'
# Photo uploads need the ClamAV malware scanner (compose.scanner.yaml); ./scripts/install.sh add-scanner turns
# it on. CLAMD_ADDRESS is where the app asks it to scan each upload: blank keeps uploads off, and with the
# scanner it is clamd:3310, together with the scanner profile in COMPOSE_PROFILES and compose.scanner.yaml in
# COMPOSE_FILE. See docs/operator-guide.md#photo-uploads-and-the-malware-scanner.
CLAMD_ADDRESS=
# Uploads pause while the scanner's daily signatures are older than this many days (7 to 90); blank is 30.
# ./scripts/install.sh refresh-scanner (and upgrade) pulls newer ones.
SCANNER_MAX_SIGNATURE_AGE_DAYS=
# The most all stored photos and avatars may use together, in MB; blank is 2048. See
# docs/operator-guide.md#troubleshooting ("Photo storage and upload limits").
IMAGE_STORAGE_LIMIT_MB=
# The ClamAV image: one release with signatures, a MAJOR.MINOR.PATCH tag (optionally -debian). Upstream
# rebuilds the same tag with newer signatures; ./scripts/install.sh refresh-scanner pulls them.
CLAMAV_IMAGE=clamav/clamav:1.5.4-debian
# Monero escrow: off unless ESCROW_XMR=on. The installer uses the selected local stagenet or mainnet daemon; the runtime
# also accepts a local fakechain. Mainnet needs MONERO_NETWORK=mainnet (custodial, real funds); no mainnet run is recorded.
# See docs/operator-guide.md#monero-escrow
# for setup and verification limits. It needs its own monero-wallet-rpc (ESCROW_XMR_WALLET_RPC_URL, never
# MONERO_WALLET_RPC_URL's) and a daemon on the configured network (ESCROW_XMR_DAEMON_URL), both with
# credentials as userinfo if they have a login. ESCROW_XMR_SEED_KEY is the path, inside the app container, of an armored
# OpenPGP public key file (its private key stays offline). MONERO_WALLET_SECRET: openssl rand -hex 32, different from
# SETUP_TOKEN and APP_SECRET_KEY, backed up with this file. Blank values use the app defaults: 20 free accounts (5 to
# 200), a network fee cap of 10000000000 piconero (0.01 XMR), market fee 0 basis points (ESCROW_XMR_FEE_ADDRESS is
# needed above 0). On stagenet, `./scripts/install.sh --monero local --monero-network stagenet --monero-escrow yes
# --monero-escrow-seed-key FILE` sets them for the bundled nodes: the monero-escrow-wallet service (its own volume;
# ESCROW_XMR_WALLET_RPC_PASSWORD is its --rpc-login password, generated, the same as in ESCROW_XMR_WALLET_RPC_URL)
# sharing the monero service's daemon, a generated MONERO_WALLET_SECRET, and the seed key copied to
# escrow-xmr-seed-key.asc, which compose.escrow-xmr.yaml mounts at ESCROW_XMR_SEED_KEY=/etc/opsecmkt/escrow-xmr-seed-key.asc.
ESCROW_XMR=
ESCROW_XMR_WALLET_RPC_URL=
ESCROW_XMR_DAEMON_URL=
ESCROW_XMR_FEE_BPS=
ESCROW_XMR_FEE_ADDRESS=
ESCROW_XMR_SLOTS=
ESCROW_XMR_MAX_FEE=
ESCROW_XMR_SEED_KEY=
# Monero escrow with APP_MODE=tor (A-515): the escrow wallet-rpc relays each settlement through its daemon, from this
# host's IP address unless that daemon is behind Tor. So in Tor mode settlements are built and stored but not relayed
# unless COMPOSE_FILE includes compose.nodes-tor.yaml (the local monerod through its own Tor client; Monero over Tor is
# unverified) or this is clearnet-accepted (relay without Tor, accepting the exposure). Blank or clearnet-accepted;
# any other value stops startup. See docs/operator-guide.md#monero-escrow.
ESCROW_XMR_TOR_RELAY=
MONERO_WALLET_SECRET=
ESCROW_XMR_WALLET_RPC_PASSWORD=

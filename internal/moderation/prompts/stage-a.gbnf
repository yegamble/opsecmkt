root ::= "{" ws "\"findings\"" ws ":" ws findings ws "," ws "\"injection_suspected\"" ws ":" ws boolean ws "," ws "\"canary\"" ws ":" ws {{CANARY}} ws "}"
findings ::= "[" ws "]" | "[" ws no-finding ws "]" | "[" ws finding-list ws "]"
no-finding ::= "{" ws "\"reason_code\"" ws ":" ws {{NO_FINDING}} ws "," ws "\"evidence_ids\"" ws ":" ws evidence-ids ws "}"
{{FINDING_LIST}}
evidence-ids ::= {{EVIDENCE_ARRAY}}
boolean ::= "true" | "false"
ws ::= [ \t\n]{0,4}

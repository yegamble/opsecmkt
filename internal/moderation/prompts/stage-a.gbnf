root ::= "{" ws "\"findings\"" ws ":" ws "[" ws (finding (ws "," ws finding){0,15})? ws "]" ws "," ws "\"injection_suspected\"" ws ":" ws boolean ws "," ws "\"canary\"" ws ":" ws {{CANARY}} ws "}" ws
finding ::= "{" ws "\"reason_code\"" ws ":" ws reason ws "," ws "\"evidence_ids\"" ws ":" ws evidence-ids ws "}"
reason ::= {{REASONS}}
evidence-ids ::= {{EVIDENCE_ARRAY}}
boolean ::= "true" | "false"
ws ::= [ \t\n\r]*

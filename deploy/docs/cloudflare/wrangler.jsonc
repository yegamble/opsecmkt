// Cloudflare Worker for the documentation site: docs/development.md#serve-the-docs-from-cloudflare.
// Build the site first (mkdocs build, into site/ at the repository root), then deploy from this directory.
{
  "name": "opsecmkt-docs",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../../site",
    "binding": "ASSETS",
    // The Worker adds the security headers and Onion-Location to every response, assets included.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "observability": { "enabled": false },
  // Set at deploy time: wrangler deploy --var DOCS_ONION:<address>.onion
  "vars": { "DOCS_ONION": "" }
}
